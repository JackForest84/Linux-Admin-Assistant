[Unit]
Description=linuxcmd web app
After=network.target

[Service]
Type=simple
User=jakub
Group=jakub
WorkingDirectory=/opt/linuxcmd
Environment="PATH=/opt/linuxcmd/.venv/bin"
ExecStart=/opt/linuxcmd/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
